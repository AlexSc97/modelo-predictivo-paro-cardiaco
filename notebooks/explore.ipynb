import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt

# Cargar el dataset
# Asumiendo que el notebook se ejecuta desde src/notebooks
df = pd.read_csv('../data/raw/HeartAttackDataSet.csv')

# Mostrar las primeras filas
print(df.head())

# Configurar el estilo de seaborn
sns.set_theme(style="whitegrid")

# --- GRÁFICO 1: Variable Objetivo Normalizada (%) ---

# Calcular los porcentajes
target_percent = df['target'
].value_counts(normalize=True).mul(100).rename('percent').reset_index()
# Renombrar columnas para asegurar consistencia (dependiendo de la versión de pandas)
target_percent.columns = ['target', 'percent'
]

plt.figure(figsize=(8,
6))
# Usamos barplot para graficar los valores calculados previamente
ax = sns.barplot(x='target', y='percent', data=target_percent, palette='viridis')

# Añadir títulos y etiquetas
plt.title('Distribución de la Variable Objetivo (Porcentaje)', fontsize=16)
plt.xlabel('Target (0 = No Riesgo,
1 = Riesgo)', fontsize=12)
plt.ylabel('Porcentaje (%)', fontsize=12)
plt.ylim(0,
100) # Establecer límite y de 0 a 100 para mejor visualización

# Mostrar los valores porcentuales encima de las barras
for p in ax.patches:
    ax.annotate(f'{p.get_height():.1f
}%', 
                (p.get_x() + p.get_width() / 2., p.get_height()),
                ha='center', va='baseline', fontsize=12, color='black', xytext=(0,
5),
                textcoords='offset points')

plt.show()

# --- GRÁFICO 2: Dolor de Pecho vs Target (Original) ---
# Mantenemos este gráfico como referencia adicional
plt.figure(figsize=(10,
6))
sns.countplot(x='cp', hue='target', data=df, palette='Set2')
plt.title('Tipo de Dolor de Pecho vs Target', fontsize=16)
plt.xlabel('Tipo de Dolor de Pecho (cp)', fontsize=12)
plt.ylabel('Cantidad', fontsize=12)
plt.legend(title='Target', loc='upper right')
plt.show()
